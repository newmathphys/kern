{
  "name": "kern-lens",
  "displayName": "KERN Lens",
  "description": "Подсветка статуса истины KERN (e=1) прямо в редакторе",
  "version": "0.1.0",
  "publisher": "kern",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Other"],
  "activationEvents": ["onCommand:kernLens.checkIntegrity", "onCommand:kernLens.status"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "kernLens.checkIntegrity", "title": "KERN: Проверить целостность образа" },
      { "command": "kernLens.status", "title": "KERN: Статус проекта (.kern)" }
    ]
  },
  "scripts": { "compile": "tsc -p ./" },
  "devDependencies": { "typescript": "^5.0.0", "@types/node": "^20.0.0", "@types/vscode": "^1.75.0" }
}
