(set-logic ALL)
(declare-const x Int)
(declare-const lo Int)
(declare-const hi Int)
(declare-const res_old Int)
(declare-const res_new Int)
(assert (= res_old (ite (>= lo (ite (<= x hi) x hi)) lo (ite (<= x hi) x hi))))
(assert (= res_new (ite (> lo hi) lo (ite (< x lo) lo (ite (> x hi) hi x)))))
(assert (distinct res_old res_new))
(check-sat)
