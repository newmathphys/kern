ВОСПРОИЗВЕСТИ ОДНОЙ КОМАНДОЙ
--------------------------------------------------------------------------------
  git clone --no-hardlinks <repo> /tmp/kern-repro && cd /tmp/kern-repro
  export XDG_CACHE_HOME=/tmp/kern-cache-empty     # ~/.cache/kern НЕ использовать
  python3 -m venv .venv && .venv/bin/pip install -r requirements.txt
  for g in ci-fast tour xray-precision xray-overflow-check audits pcc-offline-check verify-attestation; do
    t0=$(date +%s); make "$g"; rc=$?; echo "$g rc=$rc $(( $(date +%s) - t0 ))s"
  done
