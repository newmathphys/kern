[
  {
    "id": "unsat_fee_corridor",
    "kind": "explain",
    "block": "03",
    "sphere": "Комиссия/финтех",
    "trick": "непроходимый коридор комиссии min_fee > max_fee при двух невиновных пунктах",
    "sphere_en": "Fees/fintech",
    "trick_en": "impossible fee corridor min_fee > max_fee with two innocent clauses",
    "doc": {
      "vars": [
        "min_fee",
        "max_fee",
        "tier"
      ],
      "clauses": [
        {
          "id": "noise_tier_nonneg",
          "expr": "tier >= 0"
        },
        {
          "id": "min_floor",
          "expr": "min_fee >= 10"
        },
        {
          "id": "max_cap",
          "expr": "max_fee <= 5"
        },
        {
          "id": "order_ok",
          "expr": "min_fee <= max_fee"
        },
        {
          "id": "noise_ceiling",
          "expr": "max_fee <= 1000"
        }
      ]
    },
    "noise": [
      "noise_tier_nonneg",
      "noise_ceiling"
    ],
    "must_include": [
      "min_floor",
      "max_cap",
      "order_ok"
    ],
    "explain": {
      "code": "def fee_span(min_fee: int, max_fee: int) -> int:\n    if min_fee > max_fee:\n        return 0\n    return max_fee - min_fee\n",
      "expect": {
        "cc": 2,
        "returns": 2,
        "crash_lines": []
      }
    }
  },
