(set-logic ALL)
(declare-const addr Int)
(declare-const alignment Int)
(declare-const result Int)
(assert (and (>= addr 0) (<= addr 4294967295)))
(assert (and (>= alignment 0) (<= alignment 4294967295)))
(assert (and (>= addr 0) (> alignment 0)))
(assert (= result (+ addr (- alignment 1))))
(assert (not (>= result addr)))
(check-sat)
