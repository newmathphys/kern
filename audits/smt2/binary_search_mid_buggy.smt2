(set-logic QF_BV)
(declare-const low (_ BitVec 32))
(declare-const high (_ BitVec 32))
(declare-const result (_ BitVec 32))
(assert (and (bvsge low (_ bv0 32)) (bvsge high (_ bv0 32)) (bvsle low (_ bv2147483647 32)) (bvsle high (_ bv2147483647 32))))
(assert (= result (bvsdiv (bvadd low high) (_ bv2 32))))
(assert (not (and (bvsge result (_ bv0 32)) (bvsle result (_ bv2147483647 32)))))
(check-sat)
