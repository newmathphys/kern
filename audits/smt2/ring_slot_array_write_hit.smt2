(set-logic ALL)
(declare-const buf (Array Int Int))
(declare-const idx Int)
(declare-const val Int)
(declare-const result Int)
(assert (and (>= idx -2147483648) (<= idx 2147483647)))
(assert (and (>= val -2147483648) (<= val 2147483647)))
(assert (>= idx 0))
(assert (= result (select (store buf idx val) idx)))
(assert (not (= result val)))
(check-sat)
