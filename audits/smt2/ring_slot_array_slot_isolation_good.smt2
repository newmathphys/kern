(set-logic ALL)
(declare-const buf (Array Int Int))
(declare-const write_idx Int)
(declare-const read_idx Int)
(declare-const val Int)
(declare-const result Int)
(assert (and (>= write_idx -2147483648) (<= write_idx 2147483647)))
(assert (and (>= read_idx -2147483648) (<= read_idx 2147483647)))
(assert (and (>= val -2147483648) (<= val 2147483647)))
(assert (distinct write_idx read_idx))
(assert (= result (select (store buf write_idx val) read_idx)))
(assert (not (= result (select buf read_idx))))
(check-sat)
