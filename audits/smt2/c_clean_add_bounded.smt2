(set-logic ALL)
(declare-const a Int)
(declare-const b Int)
(declare-const result Int)
(assert (and (>= a -2147483648) (<= a 2147483647)))
(assert (and (>= b -2147483648) (<= b 2147483647)))
(assert (and (>= a (- 1000)) (<= a 1000) (>= b (- 1000)) (<= b 1000)))
(assert (= result (+ a b)))
(assert (not (= result (+ a b))))
(check-sat)
