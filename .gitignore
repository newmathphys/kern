# Замок мутационного прогона (tools/mutate_zig.py)
.mutation.lock

# Сборка Zig
zig-out/
.zig-cache/
zig-cache/

# Python-окружения (бенчмарки)
.venv/
.venv38/
.venv-evalplus/
__pycache__/
*.pyc

# Артефакты, которые генерируются заново
PROJECT_CANONICAL_SPEC.kern.md
project.kbin
release.kimg

# KERN-Next (kernx) — выходные артефакты конвейера
.kernnext/
report.md
agent_packet.json

# Датасеты/бенчмарки (скачиваются заново)
.kern/
samples*.jsonl
evalplus_results/
logs/
swebench_lite.jsonl
preds_gold.jsonl

# Секреты и аттестация (НИКОГДА не коммитить!)
.kern_seed.bin
attestation.cert
*.pem
*.key

# Архивы и разовые артефакты — НЕ место в репозитории
# (именно они раньше засоряли корень: kirin-ai-agent.zip и т.п.)
*.zip
*.tar.gz
*.kern_gold.json

# ИСКЛЮЧЕНИЕ: свидетельства бенчмарков коммитим (нужны как доказательства)
!docs/evidence/*.jsonl
!docs/evidence/*.json
!docs/evidence/*.log
!docs/evidence/*.txt

# Временное
*.log
*.tmp
*.swp
*.kate-swp

# Свидетельства бенчмарков (не игнорировать)
!docs/evidence/*.jsonl

# Локальные материалы (в репозиторий не входят)
/archive/

# Объектные файлы (создаются zig build-obj в diff_disasm)
*.o
*.o.o
*.s
